{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public-dist",
  "functions": {
    "api/submission.js": {
      "maxDuration": 300,
      "includeFiles": "js/project-data.js"
    },
    "api/site-asset.js": { "includeFiles": ".generated/site-assets.json" },
    "api/efact.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/e-fact/api/:resource", "destination": "/api/efact?resource=:resource" },
    { "source": "/e-fact/js/api/:resource", "destination": "/api/efact?resource=:resource" },
    { "source": "/apuchika/api/badges", "destination": "/api/apuchika?resource=badges" },
    { "source": "/apuchika/api/badges/:id", "destination": "/api/apuchika?resource=badges&id=:id" },
    { "source": "/apuchika/api/inquiries", "destination": "/api/apuchika?resource=inquiries" },
    { "source": "/:team(phishing-ddook|apuchika|curo|stylens|ilkko|dadeullim|omix|year-on|jigjijaembeoli|geuneuljab-i|coco-lang|magmoa|e-fact|e-fact2|byeol-ungwan)/:asset*", "destination": "/api/site-asset?path=:team/:asset*" }
  ],
  "redirects": [
    { "source": "/submit", "destination": "/submit/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/submit/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
